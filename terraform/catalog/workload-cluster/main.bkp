# 1. Define the Cluster
resource "rancher2_cluster_v2" "workload" {
  name               = "workload-prod-cluster"
  kubernetes_version = "v1.28.3+k3s1"

  # Machine pools are defined inside the rke_config block
  rke_config {
    machine_pools {
      name               = "pool-worker"
      control_plane_role = true
      etcd_role          = true
      worker_role        = true
      quantity           = 2

      machine_config {
        kind = rancher2_machine_config_v2.pool_worker.kind
        name = rancher2_machine_config_v2.pool_worker.name
      }
    }
  }
}

resource "rancher2_machine_config_v2" "pool_worker" {
  generate_name = "pool-worker-config"
  # Example for a docker-based node driver (adjust based on your actual provider)
    google_config {
        project       = "teragrunt88"
        zone          = "europe-west1-b"
        machine_type  = "e2-medium"
        machine_image = "projects/ubuntu-os-cloud/global/images/family/ubuntu-2204-lts"
        disk_size     = "50"
        disk_type     = "pd-standard"
        network       = "default"
      }
}


# Wait for the cluster to generate its kubeconfig
data "rancher2_cluster_v2" "workload_status" {
  name = rancher2_cluster_v2.workload.name
}

# Create the cluster secret in the ArgoCD namespace on your Hub cluster
resource "kubernetes_secret" "argocd_cluster_registration" {
  metadata {
    name      = "cluster-workload-prod"
    namespace = "argocd" # Must be the namespace where ArgoCD runs
    labels = {
      "argocd.argoproj.io/secret-type" = "cluster"
    }
  }

  data = {
    name   = rancher2_cluster_v2.workload.name
    # Use the Rancher proxy URL to route ArgoCD traffic securely through Rancher
    server = yamldecode(data.rancher2_cluster_v2.workload_status.kube_config)["clusters"][0]["cluster"]["server"]

    config = jsonencode({
      # Extract the service account token generated by Rancher
      bearerToken = data.rancher2_cluster_v2.workload_status.kube_config
      tlsClientConfig = {
        insecure = true
      }
    })
  }
}